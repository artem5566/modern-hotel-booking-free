{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "meta": {
    "title": "Modern Hotel Booking - Ultimate Showcase (2026)",
    "description": "Production-grade hotel website with multi-room selection, live calendars, and pre-seeded revenue data.",
    "author": "Antigravity Architect"
  },
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "constants": {
    "WP_DEBUG": true,
    "WP_DEBUG_DISPLAY": true
  },
  "login": true,
  "landingPage": "/",
  "steps": [
    {
      "step": "unzip",
      "zipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/leslieradue-web/modern-hotel-booking-free/main/playground.zip"
      },
      "extractToPath": "/wordpress"
    },
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "modern-hotel-booking"
      },
      "options": {
        "activate": true
      }
    }
  ]
}
